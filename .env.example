# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Fuel Finder (GOV.UK One Login developer portal: https://www.developer.fuel-finder.service.gov.uk)
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
# Confirm the host from the developer portal before first use.
FUEL_FINDER_BASE_URL=

# Raw storage. Local path during development; s3-compatible URL (R2/Azure) on the collector.
MILEMAP_RAW_ROOT=./data/raw

# Optional: FRED API key for Brent crude (series DCOILBRENTEU)
FRED_API_KEY=
