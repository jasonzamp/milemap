# Copy to .env and fill in. .env is git-ignored — never commit real values.

# ── Fuel Finder (https://www.developer.fuel-finder.service.gov.uk, via GOV.UK One Login)
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
# Confirm the API host from the developer portal before first use.
FUEL_FINDER_BASE_URL=

# ── Cloudflare R2 (raw store in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=milemap-raw

# Raw storage root. Local path in development; s3://milemap-raw on the collector.
MILEMAP_RAW_ROOT=./data/raw

# ── Optional: FRED API key for Brent crude (keyless CSV works without it)
FRED_API_KEY=
